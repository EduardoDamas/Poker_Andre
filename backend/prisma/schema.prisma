// CAPA CONTEST — Phase 1 database schema
// =====================================================================
// MONEY RULES (do not violate):
//   * All amounts are stored as INTEGER CENTS (BigInt). NEVER floats.
//   * Balances are NEVER updated in place. The balance of an account is the
//     SUM of its ledger entries. Money moves only by inserting balanced
//     LedgerTransactions whose entries sum to exactly zero (double-entry).
//   * Every money movement is immutable and auditable.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// IDENTITY & COMPLIANCE
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  phone        String   @unique // E.164, login by OTP or password
  facebookId   String?  @unique
  displayName  String
  // Optional password login (scrypt "salt:hash"). Set at registration; OTP still works.
  passwordHash String?
  cpf          String   @unique // validated (check digits) before insert
  birthDate    DateTime // 18+ enforced at registration
  role         Role     @default(PLAYER)
  status       UserStatus @default(ACTIVE)
  // Subscription tier — drives entry-fee discount (§5) and prize-share (§6).
  subscription Subscription @default(NONE)
  // When the subscription expires (null for NONE). Reverts to NONE past this.
  subscriptionUntil DateTime?
  blockedUntil DateTime?  // temp block expiry; null + BLOCKED = permanent
  blockReason  String?    // why the user was blocked
  // Proof of consent: when the player accepted the Termos + Privacidade, and
  // which version they saw. Null for accounts created before the app asked
  // (1.0.6 and older) — those clients send nothing rather than a false accept.
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account       Account?
  withdrawals   Withdrawal[]
  deposits      Deposit[]
  paymentOrders PaymentOrder[]
  subscriptionRequests SubscriptionRequest[]
  limits        PlayerLimit?
  seats         Seat[]
  points        PointsAccount?
  pointsTxns    PointsTransaction[]
  tournamentWins TournamentWin[]

  @@index([status])
}

// ── Points economy ──────────────────────────────────────────────────────────
// A VIRTUAL currency, fully separate from the BRL wallet ledger:
//   freePoints — earned playing (solo vs bots) and via the daily wheel/streaks.
//   paidPoints — premium points (wheel/streak rewards; later purchasable).
// Conversion both ways at 1 paid = 1000 free. Every change writes a
// PointsTransaction; daily spins and milestones are idempotent via a unique
// referenceId (points-spin-<user>-<day> / points-milestone-<user>-<days>).

model PointsAccount {
  userId      String   @id
  freePoints  BigInt   @default(0)
  paidPoints  BigInt   @default(0)
  streakDays  Int      @default(0)
  lastSpinDay String? // "YYYY-MM-DD" (UTC) of the last daily wheel spin
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model PointsTransaction {
  id          String        @id @default(uuid())
  userId      String
  kind        PointsTxnKind
  freeDelta   BigInt        @default(0)
  paidDelta   BigInt        @default(0)
  referenceId String?       @unique
  memo        String?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum PointsTxnKind {
  WHEEL
  CONVERSION
  MILESTONE
  GAME_REWARD
  SHARE
  ADJUST
}

// One row per settled tournament win — feeds the rankings (daily/weekly/
// monthly), the public winners feed, and the share-your-win points reward.
model TournamentWin {
  id         String   @id @default(uuid())
  userId     String
  level      Int
  prizeCents BigInt
  multiplier Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
}

enum Role {
  PLAYER
  ADMIN
}

// Subscription tiers (CAPACONTEST §5/§6). Higher tiers = cheaper entry + bigger
// prize share. Purchase prices are not yet provided by the client (§8).
enum Subscription {
  NONE
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum UserStatus {
  ACTIVE
  BLOCKED     // e.g. self-exclusion, fraud, KYC fail
  PENDING     // registered, not yet verified
}

// ---------------------------------------------------------------------
// DOUBLE-ENTRY WALLET
// ---------------------------------------------------------------------

// An Account is a balance container. Players have one PLAYER account each;
// the platform owns system accounts (house rake, prize pool, escrow, etc.).
model Account {
  id        String      @id @default(uuid())
  type      AccountType
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?     @unique // null for system accounts
  // Cached balance for fast reads — reconciled against SUM(entries) by a job.
  // Source of truth is ALWAYS the ledger, never this column.
  balanceCents BigInt   @default(0)
  createdAt DateTime    @default(now())

  entries   LedgerEntry[]

  @@index([type])
}

enum AccountType {
  PLAYER         // a user's credit wallet
  HOUSE_RAKE     // platform commission
  PRIZE_POOL     // tournament prize escrow
  WITHDRAWAL_CLEARING // funds reserved for a pending Pix payout
  EXTERNAL       // counter-account for deposits/withdrawals to the outside world
  PROMOTIONS     // company-funded prizes; its (negative) balance is total promo spend
}

// A balanced group of entries. The sum of entry.amountCents MUST be 0.
model LedgerTransaction {
  id          String        @id @default(uuid())
  kind        TxnKind
  // Idempotency: a game hand / withdrawal can only post once.
  referenceId String?       @unique
  memo        String?
  createdAt   DateTime      @default(now())

  entries     LedgerEntry[]

  @@index([kind])
}

enum TxnKind {
  DEPOSIT
  TOURNAMENT_BUYIN
  TOURNAMENT_PAYOUT
  TOURNAMENT_REFUND // entry returned: the room never reached its minimum
  PROMO_PRIZE     // a company-funded prize (free-entry promotion)
  RAKE
  WITHDRAWAL
  ADJUSTMENT      // admin correction (audited)
}

// One signed posting against one account. Positive = credit in, negative = out.
model LedgerEntry {
  id            String  @id @default(uuid())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  transactionId String
  account       Account @relation(fields: [accountId], references: [id])
  accountId     String
  amountCents   BigInt  // signed; entries within a transaction sum to 0
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([transactionId])
}

// ---------------------------------------------------------------------
// WITHDRAWALS (Phase 1 = manual Pix, marked by admin)
// ---------------------------------------------------------------------

model Withdrawal {
  id            String           @id @default(uuid())
  user          User             @relation(fields: [userId], references: [id])
  userId        String
  amountCents   BigInt
  pixKey        String           // player's Pix key (CPF/email/phone/random)
  status        WithdrawalStatus @default(REQUESTED)
  // When REQUESTED, funds move PLAYER -> WITHDRAWAL_CLEARING (reserved).
  // When PAID, admin confirms the manual Pix; CLEARING -> EXTERNAL.
  // When REJECTED, funds return CLEARING -> PLAYER.
  requestTxnId  String?
  settleTxnId   String?
  adminNote     String?
  requestedAt   DateTime         @default(now())
  settledAt     DateTime?

  @@index([status])
}

enum WithdrawalStatus {
  REQUESTED
  PAID
  REJECTED
}

// ---------------------------------------------------------------------
// DEPOSITS (Phase 1 = manual Pix, confirmed by admin)
// ---------------------------------------------------------------------

// A player declares an incoming Pix; the admin confirms receipt and the wallet
// is credited (EXTERNAL -> PLAYER). Mirrors the manual withdrawal flow. A real
// payment-gateway integration (auto-confirm via webhook) is a Phase-2 swap.
model Deposit {
  id           String        @id @default(uuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  amountCents  BigInt
  // Optional Pix end-to-end id / proof the player provides.
  pixReference String?
  status       DepositStatus @default(REQUESTED)
  creditTxnId  String?       // ledger txn id once credited
  adminNote    String?
  requestedAt  DateTime      @default(now())
  settledAt    DateTime?

  @@index([status])
  @@index([userId])
}

enum DepositStatus {
  REQUESTED
  CONFIRMED
  REJECTED
}

// ---------------------------------------------------------------------
// PAYMENT ORDERS (gateway = InfinitePay hosted checkout, auto-confirmed by webhook)
// ---------------------------------------------------------------------

// A charge created through a payment gateway. We mint a checkout link tied to a
// unique orderNsu; the gateway calls our webhook when it's paid, and we credit
// the wallet (idempotent via the ledger's unique referenceId = orderNsu).
model PaymentOrder {
  id          String             @id @default(uuid())
  orderNsu    String             @unique // sent to the gateway as order_nsu
  user        User               @relation(fields: [userId], references: [id])
  userId      String
  amountCents BigInt
  purpose     PaymentPurpose     @default(DEPOSIT)
  status      PaymentOrderStatus @default(PENDING)
  provider    String             @default("infinitepay")
  checkoutUrl String?
  creditTxnId String? // ledger txn id once the wallet is credited
  paidAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

enum PaymentPurpose {
  DEPOSIT
  TOURNAMENT_ENTRY
  SUBSCRIPTION
}

// A player's intent to buy a subscription plan through the merchant's FIXED
// InfinitePay link. Those links are the same for everyone, so the gateway
// webhook cannot tell us who paid (no order_nsu) — the admin confirms receipt
// in the panel, exactly like the manual Pix deposit flow. When the dynamic
// per-player checkout lands (Opção 2), confirmation becomes automatic and this
// record keeps the same shape.
model SubscriptionRequest {
  id           String                    @id @default(uuid())
  user         User                      @relation(fields: [userId], references: [id])
  userId       String
  plan         Subscription // never NONE
  amountCents  BigInt // card price shown to the player (base × 1.25)
  status       SubscriptionRequestStatus @default(REQUESTED)
  checkoutUrl  String? // the InfinitePay link opened for this plan
  // Set when the checkout was minted per-player (SUBSCRIPTION_CHECKOUT=dynamic):
  // the gateway echoes it back, so the webhook knows who paid and releases the
  // plan with no admin step. Null for the merchant's fixed links.
  orderNsu     String?                   @unique
  adminNote    String?
  // Set on confirm: when the granted subscription expires.
  grantedUntil DateTime?
  requestedAt  DateTime                  @default(now())
  settledAt    DateTime?

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------
// SCHEDULED TOURNAMENT ROOMS (client spec, 2026-09-17)
// ---------------------------------------------------------------------

// A player's seat in one 10-minute window of a level's room. The entry is
// escrowed when this row is created, so the roster MUST be durable: an
// in-memory list would strand real money across a restart.
//
// roomId encodes the level and the window start, so each window is its own
// tournament instance (fresh ledger references, no collisions).
model RoomRegistration {
  id           String                 @id @default(uuid())
  roomId       String // sala-l<level>-<windowStartMs>
  userId       String
  level        Int
  subscription Subscription           @default(NONE)
  // The window this registration belongs to (start of the 10-minute slot).
  windowStart  DateTime
  status       RoomRegistrationStatus @default(REGISTERED)
  createdAt    DateTime               @default(now())
  settledAt    DateTime?

  @@unique([roomId, userId])
  @@index([roomId, status])
  @@index([windowStart, status])
  @@index([userId, status])
}

// ---------------------------------------------------------------------
// PROMOTIONS (client, 2026-09-21: free-entry tournament, one prize)
// ---------------------------------------------------------------------

// A promotional event with a single company-funded prize. Entry is free, so
// there is no pool: the prize is paid from the PROMOTIONS account. The amount
// depends on whether the winner was a subscriber when the tournament started.
// winnerId/paidAt make the payout auditable, and the unique ledger reference
// promo-prize-<id> makes it impossible to pay twice.
model PromoEvent {
  id                   String           @id @default(uuid())
  name                 String
  startsAt             DateTime
  prizeCents           BigInt // non-subscriber prize
  prizeSubscriberCents BigInt // subscriber prize
  // Fewest players for the tournament to start at startsAt; below it the room
  // keeps waiting (and closes unplayed if nobody comes — nothing is paid).
  minPlayers           Int              @default(2)
  status               PromoEventStatus @default(SCHEDULED)
  winnerId             String?
  winnerSubscribed     Boolean?
  prizePaidCents       BigInt?
  prizeTxnId           String?
  paidAt               DateTime?
  createdAt            DateTime         @default(now())

  @@index([status, startsAt])
}

enum PromoEventStatus {
  SCHEDULED
  PAID
  CANCELLED
}

enum RoomRegistrationStatus {
  REGISTERED // paid, waiting for the window to open
  STARTED // the tournament ran with this player in it
  REFUNDED // the window missed its minimum; entry given back
  CANCELLED // the player pulled out before the start; entry given back
}

enum SubscriptionRequestStatus {
  REQUESTED
  CONFIRMED
  REJECTED
}

// ---------------------------------------------------------------------
// RESPONSIBLE GAMING — limits the PLAYER sets on themselves
// ---------------------------------------------------------------------

// Self-imposed deposit ceilings and self-exclusion. Null = no limit for that
// window. Lowering a limit (or excluding yourself) takes effect immediately;
// RAISING one only takes effect after a cooling-off period, so a player cannot
// undo their own protection in the heat of the moment — the higher values wait
// in pending* until pendingEffectiveAt, then the service promotes them on read.
//
// These are the player's own limits. Admin blocks are separate (User.status).
model PlayerLimit {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id])
  // Max total deposited per rolling window, in cents. Null = unlimited.
  dailyCents          BigInt?
  weeklyCents         BigInt?
  monthlyCents        BigInt?
  // A raise waiting out the cooling-off period (all three move together).
  pendingDailyCents   BigInt?
  pendingWeeklyCents  BigInt?
  pendingMonthlyCents BigInt?
  pendingEffectiveAt  DateTime?
  // Self-exclusion: no deposits and no money games until this passes.
  // Null = not excluded; far-future date = indefinite.
  selfExcludedUntil   DateTime?
  updatedAt           DateTime  @updatedAt
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
}

// ---------------------------------------------------------------------
// AUTH — phone OTP challenges
// ---------------------------------------------------------------------

// One-time login code sent to a phone. The plaintext code is never stored —
// only a hash. Short-lived; limited verification attempts.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ---------------------------------------------------------------------
// AUDIT — immutable trail of sensitive (money / admin) actions
// ---------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String // user who performed the action (e.g. the admin)
  action     String // e.g. "withdrawal.approve"
  targetType String // e.g. "withdrawal"
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

// ---------------------------------------------------------------------
// POKER DOMAIN (Texas Hold'em)
// ---------------------------------------------------------------------

model Table {
  id          String   @id @default(uuid())
  name        String
  maxSeats    Int      @default(8)
  level       Int      @default(1) // tournament level 1..7 (prize table)
  status      TableStatus @default(WAITING)
  createdAt   DateTime @default(now())

  seats       Seat[]
  hands       Hand[]
}

enum TableStatus {
  WAITING
  RUNNING
  CLOSED
}

model Seat {
  id        String  @id @default(uuid())
  table     Table   @relation(fields: [tableId], references: [id])
  tableId   String
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  position  Int     // 0..maxSeats-1
  stackCents BigInt @default(0) // chips in front of player (in-game)
  joinedAt  DateTime @default(now())

  @@unique([tableId, position])
  @@index([userId])
}

// A single dealt hand. The server records the authoritative outcome.
// The deck/seed is stored for audit & dispute resolution.
model Hand {
  id            String   @id @default(uuid())
  table         Table    @relation(fields: [tableId], references: [id])
  tableId       String
  handNumber    Int
  // Commit-reveal anti-fraud: server commits to a hashed seed before the hand,
  // reveals the seed after, so the shuffle can be independently verified.
  seedHash      String   // SHA-256 of the server seed (published pre-deal)
  seedReveal    String?  // the seed itself (published post-hand)
  boardCards    String?  // e.g. "Ah Kd Qc 7s 2h"
  potCents      BigInt   @default(0)
  result        Json?    // winners, amounts, hand ranks — authoritative
  createdAt     DateTime @default(now())

  @@unique([tableId, handNumber])
}
