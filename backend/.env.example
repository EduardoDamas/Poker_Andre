# Copy to .env and fill in. NEVER commit .env.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://capa:capa_dev_password@localhost:5434/capa_contest?schema=public"

# --- Redis (live game state / socket adapter) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Phone OTP provider (Phase 1 can stub/log codes in dev)
OTP_PROVIDER="dev"           # dev | twilio | zenvia | firebase
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Compliance ---
MIN_AGE=18
